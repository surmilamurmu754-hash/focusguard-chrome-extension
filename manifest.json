
{
  "manifest_version": 3,
  "name": "FocusGuard",
  "version": "1.0",
  "description": "Stay focused by blocking distracting websites.",
  "permissions": ["storage", "tabs", "alarms"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
